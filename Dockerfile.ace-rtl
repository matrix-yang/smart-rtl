FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

ENV DEBIAN_FRONTEND=${DEBIAN_FRONTEND} \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    ACE_RTL_REPO=/workspace/ace

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git curl ca-certificates \
    python3 python3-dev python3-venv python3-pip \
    gperf flex bison autoconf automake libtool make perl help2man \
    libfl2 libfl-dev zlib1g zlib1g-dev \
    tcl-dev libreadline-dev libffi-dev pkg-config \
    wget gnupg \
    libxml2-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp

# Build and install OSS simulators required by CVDP rows.
RUN git clone --depth 1 --branch v13_0 \
        https://github.com/steveicarus/iverilog.git /tmp/iverilog && \
    cd /tmp/iverilog && sh autoconf.sh && \
    ./configure --prefix=/usr/local && make -j"$(nproc)" && make install && \
    rm -rf /tmp/iverilog

RUN git clone --depth 1 --branch yosys-0.40 \
        https://github.com/YosysHQ/yosys.git /tmp/yosys && \
    cd /tmp/yosys && make -j"$(nproc)" PREFIX=/usr/local && \
    make install PREFIX=/usr/local && rm -rf /tmp/yosys

RUN git clone --depth 1 --branch v5.038 \
        https://github.com/verilator/verilator.git /tmp/verilator && \
    cd /tmp/verilator && autoconf && \
    ./configure --prefix=/usr/local && make -j"$(nproc)" && make install && \
    rm -rf /tmp/verilator

ENV PYTHON_BIN=/usr/bin/python3

# Python virtualenv for ACE-RTL runtime + adapter dependencies.
RUN python3 -m venv /opt/ace-rtl-venv && \
    /opt/ace-rtl-venv/bin/pip install --upgrade pip

COPY requirements.txt /tmp/requirements.txt
RUN /opt/ace-rtl-venv/bin/pip install -r /tmp/requirements.txt

WORKDIR ${ACE_RTL_REPO}
COPY . ${ACE_RTL_REPO}
RUN ln -sf /opt/ace-rtl-venv ${ACE_RTL_REPO}/.cvdp-native

# Ensure cocotb can find shared Python library in strict environments.
RUN python3 - <<'PY'
import pathlib
import sysconfig

libdir = pathlib.Path(sysconfig.get_config_var("LIBDIR") or "/usr/lib")
ldname = sysconfig.get_config_var("LDLIBRARY")
path = None
if ldname:
    p = libdir / ldname
    if p.exists():
        path = p
if path is None:
    cands = [libdir / "libpython3.12.so", libdir / "libpython3.12.so.1.0"]
    for c in cands:
        if c.exists():
            path = c
            break
if path is not None:
    print(path)
PY

ENV PATH=/opt/ace-rtl-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    VIRTUAL_ENV=/opt/ace-rtl-venv
